{
  "framework": "nextjs",
  "ignoreCommand": "p=\"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\"; git cat-file -e \"$p^{commit}\" 2>/dev/null && git diff --quiet \"$p\" HEAD -- . && exit 0; exit 1",
  "crons": [
    {
      "path": "/api/cron/nfl-pool-capture",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/event-closing-lines",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/dispatch",
      "schedule": "7,22,37,52 * * * *"
    },
    {
      "path": "/api/cron/nfl-slate-check",
      "schedule": "12,42 * * * *"
    },
    {
      "path": "/api/cron/health-check",
      "schedule": "3,33 * * * *"
    },
    {
      "path": "/api/cron/nfl-ghost",
      "schedule": "*/5 * * * *"
    }
  ]
}
